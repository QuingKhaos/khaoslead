{
  "name": "khaoslead",
  "title": "Lead Revamped",
  "description": "Adds lead ore and plates to the base game as an early game resource. Lead is used in ammunition, pipes, batteries and a few other places.",
  "author": "QuingKhaos",
  "homepage": "https://discord.gg/SYmkaDjFCt",
  "version": "0.2.1",
  "factorio_version": "2.1",
  "dependencies": [
    "base >= 2.1.11",
    "! space-age",

    "khaoslib >= 2.1.0",
    "? khaossilicon >= 0.1.0",

    "? eve-weaponry >= 0.9.0",
    "? fixLargeElectricPole >= 1.4.0",
    "? Howitzer >= 0.5.2",
    "(?) More_Ammo >= 1.5.22",
    "? more-ammo-redux >= 2.0.1",

    "! bzlead",
    "! bzlead2",
    "! bzsilicon",
    "! bzsilicon2"
  ],
  "package": {
    "ignore": [
      "mod_info.yml",
      "**/*.blend",
      "**/*.md",
      "**/*.svg",
      "**/*.xcf"
    ]
  }
}
